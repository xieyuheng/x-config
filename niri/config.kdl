// niri 主配置入口。
// 实际内容拆分到 config/ 目录下，通过 include 引入。
// include 路径相对于本文件解析，且不支持通配符，需要逐个列出。

// 设备与输出
include "config/input.kdl"
include "config/outputs.kdl"

// 布局与外观
include "config/layout.kdl"
include "config/cursor.kdl"
include "config/environment.kdl"
include "config/misc.kdl"

// 启动项
include "config/startup.kdl"

// 窗口规则
include "config/window-rules.kdl"

// 快捷键（多个 binds 块会自动合并，后面的同名键覆盖前面的）
include "config/binds/launcher.kdl"
include "config/binds/navigation.kdl"
include "config/binds/workspaces.kdl"
include "config/binds/media.kdl"
include "config/binds/system.kdl"
