#!/bin/sh
# --session tells niri to export WAYLAND_DISPLAY / XDG_CURRENT_DESKTOP to the
# D-Bus session (and systemd) activation environment, and to run D-Bus services
# such as xdg-desktop-portal. Without it, portal backends start without a
# Wayland display and file chooser dialogs never appear (file uploads break).
export XDG_CURRENT_DESKTOP=niri
exec dbus-run-session -- niri --session

